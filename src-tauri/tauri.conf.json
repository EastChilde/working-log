{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "工作清单助手",
  "version": "0.2.0",
  "identifier": "com.wjn.workinglog",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "工作清单助手",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "decorations": false,
        "shadow": true
      },
      {
        "label": "sticky",
        "title": "便签",
        "url": "sticky.html",
        "width": 300,
        "height": 440,
        "minWidth": 240,
        "minHeight": 300,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}
